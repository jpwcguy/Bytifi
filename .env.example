BYTIFI_API_KEY=usk_your_api_key_here

# PyPI publish (twine / local releases). Copy to .env and fill in.
# Create token: https://pypi.org/manage/account/token/
PYPI_API_TOKEN=pypi-your_token_here

# TestPyPI dry run: https://test.pypi.org/manage/account/token/
PYPI_TEST_API_TOKEN=pypi-your_test_token_here
